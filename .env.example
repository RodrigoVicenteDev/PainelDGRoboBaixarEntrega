# Login SSW (mesmo usuário vira o "dono" da capa 040 → "Gerar meus")
SITE_DOMINIO=DAG
SITE_CPF=
SITE_USER=
SITE_PASS=

# 1 = sem janela (padrão, servidor); 0 = ver o navegador
HEADLESS=1
# 1 = salva prints em debug/
DEBUG=0
# atraso entre ações do Playwright (ms), útil p/ assistir
SLOWMO=0

# Padrões da baixa (padrão do Arquivo: ASSINATURA / RUBRICA; sem hora no canhoto = 1200)
BAIXA_RECEBEDOR_PADRAO=ASSINATURA
BAIXA_PARENTESCO_PADRAO=RUBRICA
BAIXA_HORA_PADRAO=1200

# Tempos de espera (ms)
TIMEOUT_BAIXA_MS=45000
TIMEOUT_UPLOAD_MS=120000
